<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:backgroundTint="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_download_storage_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_choose_download_folder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="資料夾"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_import_download_files"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="匯入"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_reset_download_folder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="預設"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_download_files_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress_download_storage_usage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progressTint="#BB86FC" />

        <TextView
            android:id="@+id/tv_download_phone_free"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
