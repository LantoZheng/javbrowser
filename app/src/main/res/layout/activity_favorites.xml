<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Nav bar -->
        <LinearLayout
            android:id="@+id/nav_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#F5F5F5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/btn_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="🏠"
                android:textSize="16sp" />

            <!-- Filter drawer toggle -->
            <Button
                android:id="@+id/btn_filter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="🏷"
                android:textSize="16sp"
                android:backgroundTint="#E0E0E0" />

            <!-- Sort toggle -->
            <Button
                android:id="@+id/btn_sort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="↕"
                android:textSize="16sp"
                android:backgroundTint="#E0E0E0" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="搜尋收藏..."
                android:padding="8dp"
                android:background="@android:color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch" />

        </LinearLayout>

        <!-- Active filter indicator (hidden when no filter) -->
        <LinearLayout
            android:id="@+id/ll_active_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#E3F2FD"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/nav_container"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ll_filter_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="2dp" />

        </LinearLayout>

        <!-- 批量刪除操作列（選擇模式時顯示） -->
        <LinearLayout
            android:id="@+id/ll_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#212121"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/footer"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/btn_select_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="取消"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="全選"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_delete_selected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="🗑️ 刪除(0)"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <include
            android:id="@+id/footer"
            layout="@layout/include_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_favorites"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toTopOf="@id/ll_selection_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_active_filter" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No favorites yet"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Left drawer ── -->
    <ScrollView
        android:id="@+id/drawer_scroll"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FAFAFA"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="快速篩選"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <Button
                    android:id="@+id/btn_clear_all_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="✕ 清除條件"
                    android:textSize="12sp"
                    android:backgroundTint="#9E9E9E"
                    android:textColor="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/btn_delete_mode"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="🗑️"
                    android:textSize="14sp"
                    android:backgroundTint="#F44336"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

            </LinearLayout>

            <!-- Custom labels section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E0F7FA"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏷️ 自訂標籤"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#006064" />

                <Button
                    android:id="@+id/btn_tag_edit_mode"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="✎"
                    android:textSize="13sp"
                    android:backgroundTint="#00838F"
                    android:textColor="#FFFFFF"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_filter_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Date section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 加入日期"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4527A0"
                android:background="#EDE7F6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/ll_filter_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Year section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗓 上市年份"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4527A0"
                android:background="#EDE7F6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/ll_filter_years"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Actress section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👩 女優"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C2185B"
                android:background="#FCE4EC"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/et_female_search"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="搜尋女優..."
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:color/white"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <LinearLayout
                android:id="@+id/ll_filter_actors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Male actor section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👨 男優"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:background="#E3F2FD"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/et_male_search"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="搜尋男優..."
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:color/white"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <LinearLayout
                android:id="@+id/ll_filter_male_actors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Rating section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ 評分"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F57F17"
                android:background="#FFF9C4"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/ll_filter_ratings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Vote count section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 評價人數"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#00695C"
                android:background="#E0F2F1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/ll_filter_votes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <!-- Genre section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏷 類別"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:background="#E3F2FD"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/ll_filter_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
